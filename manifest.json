{
  "manifest_version": 3,
  "name": "Fantasy Draft Command Center",
  "version": "0.5.0",
  "description": "Manual fantasy football draft companion with live recommendations, roster tracking, and make-it-back estimates.",
  "permissions": ["storage"],
  "host_permissions": ["https://fantasy.espn.com/*", "https://www.espn.com/*"],
  "action": {
    "default_title": "Fantasy Draft Command Center",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://fantasy.espn.com/*", "https://www.espn.com/*"],
      "js": ["players.js", "engine.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}