{
  "manifest_version": 3,
  "name": "Fantasy Draft Command Center",
  "version": "0.1.0",
  "description": "Live ESPN fantasy football draft companion with auto-sync, rapid entry, roster-aware recommendations, and return probability.",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": ["https://fantasy.espn.com/*", "https://www.espn.com/*"],
  "action": {
    "default_title": "Fantasy Draft Command Center",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://fantasy.espn.com/*", "https://www.espn.com/*"],
      "js": ["players.js", "engine.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
